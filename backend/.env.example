# --- Core ---
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/hippocrm

# --- Auth (REQUIRED) ---
# Server refuses to start without a JWT_SECRET (no insecure fallback).
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRE=24h

# --- CORS (optional) ---
# Comma-separated allowed origins in production, e.g. https://app.example.com
# Leave unset to allow all (dev only).
# CORS_ORIGINS=https://your-frontend.example.com

# --- Naksa OCR via Google Gemini Vision (optional) ---
# Without this key the OCR pipeline returns a clearly-labelled SAMPLE dataset
# (flagged for human review). Add the key to enable real map extraction.
# GEMINI_API_KEY=your_google_generative_ai_key
# GEMINI_VISION_MODEL=gemini-1.5-pro

# --- File storage on AWS S3 (optional) ---
# Without these the uploaded naksa file is NOT persisted (a placeholder URL is used).
# AWS_ACCESS_KEY_ID=your_key
# AWS_SECRET_ACCESS_KEY=your_secret
# AWS_REGION=ap-south-1
# AWS_S3_BUCKET=your-bucket-name
